<!-- (NewRcrd/ModfdRcrd/TermntdRcrd) carrying FinInstrmGnlAttrbts + Issr.      -->
<Envelope>
  <FinInstrm>
    <NewRcrd>
      <FinInstrmGnlAttrbts>
        <Id>XS0000000101</Id>
        <FinInstrmTp>CRPB</FinInstrmTp>
        <ClssfctnTp>DBFUGB</ClssfctnTp>
        <NtnlCcy>EUR</NtnlCcy>
      </FinInstrmGnlAttrbts>
      <Issr>00000000000000000101</Issr>
      <FinInstrmRptgRprtSts>SYNTH-RPT-0001</FinInstrmRptgRprtSts>
    </NewRcrd>
  </FinInstrm>
  <FinInstrm>
    <ModfdRcrd>
      <FinInstrmGnlAttrbts>
        <Id>XS0000000102</Id>
        <FinInstrmTp>CRPB</FinInstrmTp>
        <ClssfctnTp>DBFUGB</ClssfctnTp>
        <NtnlCcy>EUR</NtnlCcy>
      </FinInstrmGnlAttrbts>
      <!-- Missing issuer LEI (field 5): must QUARANTINE in the resolver. -->
      <Issr></Issr>
    </ModfdRcrd>
  </FinInstrm>
  <FinInstrm>
    <TermntdRcrd>
      <FinInstrmGnlAttrbts>
        <Id>XS0000000103</Id>
        <FinInstrmTp>SHRS</FinInstrmTp>
        <ClssfctnTp>ESXXXX</ClssfctnTp>
